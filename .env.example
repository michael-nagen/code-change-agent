# Example environment file for the real AI smoke test.
#
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
#
# Do NOT commit real secrets. `.env` is gitignored; this `.env.example` is not.

# Required: your OpenAI-compatible provider API key.
# Required: the model id to use (e.g. gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# Optional: override the endpoint for OpenAI-compatible gateways.
# Defaults to https://api.openai.com/v1 when unset.
OPENAI_BASE_URL=https://api.openai.com/v1
