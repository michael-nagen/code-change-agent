# Example environment file for the real AI smoke test.
#
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
#
# Do NOT commit real secrets. `.env` is gitignored; this `.env.example` is not.

# Required for real mode (npm run ui with UI_MODE=real, and npm run smoke:real-ai):
#   your OpenAI-compatible provider API key and the model id to use.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: override the endpoint for OpenAI-compatible gateways.
# Defaults to https://api.openai.com/v1 when unset.
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: cap the output tokens per model response (positive integer).
# Defaults to 8192. Raise this only if a very large artifact is being truncated.
OPENAI_MAX_TOKENS=8192

# Optional: abort a model request after this many milliseconds (positive integer).
# Defaults to 60000 (60s); prevents a stalled provider from hanging a run.
OPENAI_TIMEOUT_MS=60000

# --- UI engine mode ---
# 'mock' (default): clearly-labeled fake demo data, no AI calls.
# 'real': uses the OpenAI env above. Requires OPENAI_API_KEY + OPENAI_MODEL.
UI_MODE=mock

# --- Developer memory (persistent, storage-agnostic) ---
# MEMORY_STORE=file | memory | db
#   file   (default) durable JSON files under MEMORY_DATA_DIR (great locally)
#   memory in-memory, tests/ephemeral only
#   db     external Postgres via DATABASE_URL (survives deploys/serverless)
MEMORY_STORE=file

# Used only when MEMORY_STORE=file
MEMORY_DATA_DIR=data/memory

# Used only when MEMORY_STORE=db (ignored otherwise). Standard Postgres URL —
# provider-agnostic (Supabase, Neon, RDS, local). Tables auto-create on first use.
# Supabase: use the pooled "Connection string" (Session mode) from
#   Project Settings -> Database, e.g.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# URL-encode any special characters in the password. Verify with: npm run check:db
DATABASE_URL=

# The single MVP user id used to key memory. Defaults to 'local'.
MEMORY_USER_ID=local

# --- Telegram bot (thin command interface over the same workflow + memory) ---
# Disabled unless TELEGRAM_BOT_TOKEN is set. It drives the SAME analysis engine
# and MemoryStore the UI uses (mock output unless UI_MODE=real). See
# docs/integrations-setup.md. Generation commands need the engine configured
# (UI_MODE=real + OPENAI_API_KEY for real output) and enough input (pasted
# spec/diff, GITHUB_DEFAULT_PR_URL, or a saved active spec summary).
# The bot token from BotFather. Never logged.
TELEGRAM_BOT_TOKEN=
# Secret echoed back by Telegram in the webhook header; validated when set.
TELEGRAM_WEBHOOK_SECRET=
# Comma/space separated chat ids allowed to use the bot. EMPTY = closed (deny-all).
TELEGRAM_ALLOWED_CHAT_IDS=
# Default project used by commands when a chat gives none.
TELEGRAM_DEFAULT_PROJECT=
# Public webhook URL (used only for the setWebhook setup step).
TELEGRAM_WEBHOOK_URL=

# --- Source integrations (Notion / GitHub) ---
# Disabled by default. The manual paste flow works with all of these unset.
# See docs/integrations-setup.md for the full operator setup guide.
SOURCE_INTEGRATIONS_ENABLED=false

# Notion: create an internal integration, share the page with it, then set:
NOTION_API_KEY=
NOTION_DEFAULT_PAGE_ID=

# GitHub: a public PR URL needs no token; a fine-scoped token helps rate limits
# (and is required for private repos, which are not fully supported yet).
GITHUB_TOKEN=
GITHUB_DEFAULT_PR_URL=
